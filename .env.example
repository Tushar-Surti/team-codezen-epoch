# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
GROQ_API_KEY=MLUM
# Optional: YouTube Data API v3 key (search/channel listing for data collection & Channel X-Ray)
YOUTUBE_API_KEY=

# Model routing (override only if needed)
RETENT_CLAUDE_MODEL=claude-opus-5-5
RETENT_GROQ_FAST_MODEL=openai/gpt-oss-120b
RETENT_GROQ_LIVE_MODEL=openai/gpt-oss-20b
RETENT_GROQ_ASR_MODEL=whisper-large-v3
RETENT_ENGINE_DEFAULT=auto   # deep | fast | auto

# Web → API
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
